# Saltos de línea: LF en el repositorio y en la copia de trabajo, en cualquier sistema.
# Evita diffs falsos entre Windows y macOS y los avisos "LF will be replaced by CRLF".
* text=auto eol=lf

# Scripts que Windows necesita con CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binarios: sin conversión ni diff de texto
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.zip  binary
